# Generate a token with: openssl rand -hex 32
LETTA_APP_SERVER_TOKEN=replace-with-a-random-token

# local stores agent state in the container volume. cloud stores agent state in Letta Cloud.
LETTA_BACKEND=local
PORT=4500

# Local backend model providers. Set at least one, or mount existing provider settings.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Required only when LETTA_BACKEND=cloud.
# LETTA_API_KEY=
