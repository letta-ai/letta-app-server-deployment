# Developer plans can use an API key. If unset, the computer starts OAuth device flow.
# LETTA_API_KEY=

ENV_NAME=cloud
LETTA_RESTORE_ENABLED_CHANNELS=1

# Restore Unix cron files from persistent storage on boot.
# LETTA_SYSTEM_CRON_DIR=/root/.letta/system-cron
# LETTA_SYSTEM_ROOT_CRONTAB=/root/.letta/system-crontab/root

# Point at another Letta API deployment.
# LETTA_BASE_URL=http://localhost:8283

# Use file-based token persistence in containers without a keychain.
LETTA_SKIP_KEYCHAIN_CHECK=1
